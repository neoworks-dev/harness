{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/require-await": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "no-unused-vars": "error",
    "no-param-reassign": "error",
    "no-nested-ternary": "error",
    "prefer-template": "error",
    "no-console": "warn",
    "oxc/no-barrel-file": "error",
    "local/no-empty-ternary-branch": "error",
    "local/no-chained-nullish-coalescing": "error",
    "local/no-call-result-cast": "error",
    "typescript/explicit-function-return-type": ["error", { "allowExpressions": true }]
  },
  "ignorePatterns": ["**/node_modules/**", "**/dist/**", "bin/**"],
  "jsPlugins": ["./tools/oxlint-local-plugin.ts"]
}
