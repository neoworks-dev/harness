+/** Moves the foreground task one tool call started (a Bash command, a
+ *  subagent) to the background without cancelling the turn: the tool call
+ *  returns at once and the task runs on, as Ctrl+B does in the terminal.
+ *  Without `toolCallId`, every foreground task goes. Advertised via
+ *  `InitializeResponse._meta.backgroundTasks.supported`. */
+const BACKGROUND_TASKS_METHOD = "_session/background_tasks";
+
+type BackgroundTasksRequest = {
+  sessionId: string;
+  toolCallId?: string;
+};
+
+type BackgroundTasksResponse = {
+  /** Whether any task went to the background. */
+  backgrounded: boolean;
+};
+
+function parseBackgroundTasksRequest(value: unknown): BackgroundTasksRequest {
+  if (!value || typeof value !== "object" || Array.isArray(value)) {
+    throw RequestError.invalidParams(undefined, "background tasks params must be an object");
+  }
+  const params = value as Record<string, unknown>;
+  const sessionId = typeof params.sessionId === "string" ? params.sessionId.trim() : "";
+  if (!sessionId) {
+    throw RequestError.invalidParams(
+      undefined,
+      "background tasks params require a non-empty sessionId",
+    );
+  }
+  if (params.toolCallId !== undefined && typeof params.toolCallId !== "string") {
+    throw RequestError.invalidParams(undefined, "background tasks toolCallId must be a string");
+  }
+  const toolCallId = typeof params.toolCallId === "string" ? params.toolCallId.trim() : "";
+  return toolCallId ? { sessionId, toolCallId } : { sessionId };
+}
+
 /** How urgently the SDK delivers a steered message relative to the running
  *  turn — an internal Claude implementation detail, not part of the wire
  *  contract. `now` pre-empts the current generation, while `later` waits for a
@@ -2951,6 +2987,9 @@ export class ClaudeAcpAgent {
         steering: {
           supported: true,
         },
+        backgroundTasks: {
+          supported: true,
+        },
       },
     };
   }
@@ -4171,6 +4210,14 @@ export class ClaudeAcpAgent {
     }
   }
 
+  async backgroundTasks(params: BackgroundTasksRequest): Promise<BackgroundTasksResponse> {
+    const session = this.sessions[params.sessionId];
+    if (!session || session.queryClosed) return { backgrounded: false };
+    // A tool call's id is the tool use id it reports (see toAcpNotifications).
+    const backgrounded = await session.query.backgroundTasks(params.toolCallId);
+    return { backgrounded };
+  }
+
   /** Lazily start the per-session consumer that drains the SDK query stream for
    *  the session's whole life. Idempotent: only the first `prompt()` starts it. */
   private ensureConsumer(session: Session, sessionId: string): void {
@@ -13234,6 +13281,11 @@ export function v1AgentApp(
       { parse: parseAsyncTaskStopRequest },
