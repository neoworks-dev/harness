+/** The top-level `_meta` keys of the `initialize` response that origin/main did not send. */
+const NEW_META_KEYS = ["backgroundTasks"];
+
+/** `record` without the extensions origin/main did not have, when it is an `initialize` response. */
+function withoutNewExtensions(record: Recorded): Recorded {
+  if (record.kind !== "initialize") return record;
+  const payload = record.payload as Json;
+  const meta = payload._meta as Json | undefined;
+  if (!meta || !NEW_META_KEYS.some((key) => key in meta)) return record;
+  const rest = Object.fromEntries(Object.entries(meta).filter(([k]) => !NEW_META_KEYS.includes(k)));
+  const others = without(payload, "_meta");
+  const next = Object.keys(rest).length > 0 ? { ...others, _meta: rest } : others;
+  return { ...record, payload: next } as Recorded;
+}
+
 /** `record` without the agent subagent capability, when it is an `initialize` response. */
 function withoutAgentSubagentCapability(record: Recorded): Recorded {
   if (record.kind !== "initialize") return record;
@@ -254,8 +272,9 @@ export function compareWithBaseline(baseline: Recorded[], current: Recorded[]):
