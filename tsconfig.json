{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@neoworks/extension-system": ["../extension-system/lib/index"]
    }
  },
  "include": [
    "protocol",
    "daemon",
    "harness",
    "sdk-ts",
    "sdk-ts-tools",
    "renderers/web",
    "services",
    "apps/browser",
    "apps/gui/test",
    "tools",
    "websearch",
    "openui"
  ],
  "exclude": ["**/node_modules"]
}
