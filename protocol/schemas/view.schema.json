{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "view.schema.json",
  "title": "View",
  "description": "The resolved view format: what renderers draw. The daemon resolves session events and templates into these; renderers never parse markdown, diff text or fill templates. Templates (authoring format) are documented in protocol/README.md.",
  "$defs": {
    "Component": {
      "description": "The fixed component set. Apps combine these; they never add new ones.",
      "type": "object",
      "oneOf": [
        { "$ref": "#/$defs/CardComponent" },
        { "$ref": "#/$defs/RowComponent" },
        { "$ref": "#/$defs/StackComponent" },
        { "$ref": "#/$defs/TextComponent" },
        { "$ref": "#/$defs/ImageComponent" },
        { "$ref": "#/$defs/FileComponent" },
        { "$ref": "#/$defs/CodeComponent" },
        { "$ref": "#/$defs/DiffComponent" },
        { "$ref": "#/$defs/TableComponent" },
        { "$ref": "#/$defs/KvComponent" },
        { "$ref": "#/$defs/ProgressComponent" },
        { "$ref": "#/$defs/ButtonComponent" },
        { "$ref": "#/$defs/LinkComponent" }
      ],
      "discriminator": { "propertyName": "type" }
    },
    "Tone": {
      "description": "Meaning, not color: renderers map it through the theme.",
      "type": "string",
      "enum": ["accent", "muted", "success", "danger"]
    },
    "Space": { "type": "string", "enum": ["s", "m", "l"] },
    "TextRole": { "type": "string", "enum": ["title", "body", "code"] },
    "CardComponent": {
      "description": "A titled box. TUI: a box or indented block.",
      "type": "object",
      "properties": {
        "type": { "const": "card" },
        "title": { "type": "string" },
        "tone": { "$ref": "#/$defs/Tone" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/Component" } }
      },
      "required": ["type", "children"],
      "additionalProperties": false
    },
    "RowComponent": {
      "description": "Children side by side; renderers may wrap them when space runs out.",
      "type": "object",
      "properties": {
        "type": { "const": "row" },
        "gap": { "$ref": "#/$defs/Space" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/Component" } }
      },
      "required": ["type", "children"],
      "additionalProperties": false
    },
    "StackComponent": {
      "description": "Children top to bottom.",
      "type": "object",
      "properties": {
        "type": { "const": "stack" },
        "gap": { "$ref": "#/$defs/Space" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/Component" } }
      },
      "required": ["type", "children"],
      "additionalProperties": false
    },
    "TextComponent": {
      "description": "Rich text, already parsed from markdown by the daemon.",
      "type": "object",
      "properties": {
        "type": { "const": "text" },
        "role": { "$ref": "#/$defs/TextRole" },
        "tone": { "$ref": "#/$defs/Tone" },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/Block" } }
      },
      "required": ["type", "blocks"],
      "additionalProperties": false
    },
    "ImageComponent": {
      "description": "TUI fallback (no Kitty/Sixel): [image W×H · src].",
      "type": "object",
      "properties": {
        "type": { "const": "image" },
        "src": { "type": "string", "description": "asset:// handle, file path or data: URL." },
        "alt": { "type": "string" },
        "caption": { "type": "string" },
        "width": { "type": "integer" },
        "height": { "type": "integer" }
      },
      "required": ["type", "src"],
      "additionalProperties": false
    },
    "FileComponent": {
      "description": "A file chip. TUI: 📄 path.",
      "type": "object",
      "properties": {
        "type": { "const": "file" },
        "path": { "type": "string" },
        "name": {
          "type": "string",
          "description": "Display name; defaults to the path's base name."
        }
      },
      "required": ["type", "path"],
      "additionalProperties": false
    },
    "CodeComponent": {
      "description": "A code or output block, monospace. Highlighting is optional and renderer-local.",
      "type": "object",
      "properties": {
        "type": { "const": "code" },
        "code": { "type": "string" },
        "language": { "type": "string" }
      },
      "required": ["type", "code"],
      "additionalProperties": false
    },
    "DiffComponent": {
      "description": "A change to a file as lines, already diffed by the daemon. Web/GPUI may show it side by side; TUI as a colored unified diff.",
      "type": "object",
      "properties": {
        "type": { "const": "diff" },
        "path": { "type": "string" },
        "lines": { "type": "array", "items": { "$ref": "#/$defs/DiffLine" } }
      },
      "required": ["type", "lines"],
      "additionalProperties": false
    },
    "DiffLine": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/DiffLineKind" },
        "text": { "type": "string" },
        "old": {
          "type": "integer",
          "description": "Line number in the old text (context, remove)."
        },
        "new": { "type": "integer", "description": "Line number in the new text (context, add)." }
      },
      "required": ["kind", "text"],
      "additionalProperties": false
    },
    "DiffLineKind": {
      "description": "hunk lines carry the @@ header text and separate distant changes.",
      "type": "string",
      "enum": ["context", "add", "remove", "hunk"]
    },
    "TableComponent": {
      "description": "A grid. TUI: box-drawn, columns cut to fit.",
      "type": "object",
      "properties": {
        "type": { "const": "table" },
        "columns": { "type": "array", "items": { "type": "string" } },
        "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
      },
      "required": ["type", "columns", "rows"],
      "additionalProperties": false
    },
    "KvComponent": {
      "description": "A key–value list. TUI: aligned lines.",
      "type": "object",
      "properties": {
        "type": { "const": "kv" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/KvItem" } }
      },
      "required": ["type", "items"],
      "additionalProperties": false
    },
    "KvItem": {
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "value": { "type": "string" }
      },
      "required": ["key", "value"],
      "additionalProperties": false
    },
    "ProgressComponent": {
      "description": "A bar. TUI: ▓▓▓░░ 60%.",
      "type": "object",
      "properties": {
        "type": { "const": "progress" },
        "value": { "type": "number", "minimum": 0, "maximum": 1 },
        "label": { "type": "string" }
      },
      "required": ["type", "value"],
      "additionalProperties": false
    },
    "ButtonComponent": {
      "description": "Sends ui.action when pressed. Actions starting with copy: are handled by the client (copy the rest to the clipboard). TUI: [k] Label.",
      "type": "object",
      "properties": {
        "type": { "const": "button" },
        "label": { "type": "string" },
        "action": { "type": "string", "description": "app.tool, or copy:<text>." },
        "args": { "description": "Arguments for the action." },
        "key": {
          "type": "string",
          "description": "Single-key hint; renderers bind it while the item has keyboard focus."
        }
      },
      "required": ["type", "label", "action"],
      "additionalProperties": false
    },
    "LinkComponent": {
      "description": "TUI: underlined text plus the URL.",
      "type": "object",
      "properties": {
        "type": { "const": "link" },
        "url": { "type": "string" },
        "text": { "type": "string" }
      },
      "required": ["type", "url"],
      "additionalProperties": false
    },
    "Block": {
      "description": "A block of parsed markdown.",
      "type": "object",
      "oneOf": [
        { "$ref": "#/$defs/ParagraphBlock" },
        { "$ref": "#/$defs/HeadingBlock" },
        { "$ref": "#/$defs/ListBlock" },
        { "$ref": "#/$defs/CodeBlock" },
        { "$ref": "#/$defs/QuoteBlock" },
        { "$ref": "#/$defs/RuleBlock" }
      ],
      "discriminator": { "propertyName": "type" }
    },
    "ParagraphBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "paragraph" },
        "spans": { "type": "array", "items": { "$ref": "#/$defs/Span" } }
      },
      "required": ["type", "spans"],
      "additionalProperties": false
    },
    "HeadingBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "heading" },
        "level": { "type": "integer", "minimum": 1, "maximum": 6 },
        "spans": { "type": "array", "items": { "$ref": "#/$defs/Span" } }
      },
      "required": ["type", "level", "spans"],
      "additionalProperties": false
    },
    "ListBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "list" },
        "ordered": { "type": "boolean" },
        "start": { "type": "integer", "description": "First number of an ordered list." },
        "items": { "type": "array", "items": { "$ref": "#/$defs/ListItem" } }
      },
      "required": ["type", "ordered", "items"],
      "additionalProperties": false
    },
    "ListItem": {
      "type": "object",
      "properties": {
        "checked": { "type": "boolean", "description": "Set for task list items." },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/Block" } }
      },
      "required": ["blocks"],
      "additionalProperties": false
    },
    "CodeBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "code_block" },
        "code": { "type": "string" },
        "language": { "type": "string" }
      },
      "required": ["type", "code"],
      "additionalProperties": false
    },
    "QuoteBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "quote" },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/Block" } }
      },
      "required": ["type", "blocks"],
      "additionalProperties": false
    },
    "RuleBlock": {
      "type": "object",
      "properties": { "type": { "const": "rule" } },
      "required": ["type"],
      "additionalProperties": false
    },
    "Span": {
      "description": "A run of inline text with uniform style.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "bold": { "type": "boolean" },
        "italic": { "type": "boolean" },
        "code": { "type": "boolean" },
        "strike": { "type": "boolean" },
        "href": { "type": "string" }
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "ViewItem": {
      "description": "One entry of the chat as drawn: a user message, the agent's reply, a tool call, a notice.",
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "description": "Stable id; patches and ui.action address items by it."
        },
        "kind": { "$ref": "#/$defs/ItemKind" },
        "label": {
          "type": "string",
          "description": "Who it's from (user items: the app) or the tool call's title."
        },
        "state": { "$ref": "#/$defs/ItemState" },
        "component": { "$ref": "#/$defs/Component" }
      },
      "required": ["ref", "kind", "component"],
      "additionalProperties": false
    },
    "ItemKind": {
      "type": "string",
      "enum": ["user", "agent", "thought", "tool", "notice"]
    },
    "ItemState": {
      "description": "For tool items. Renderers show it the same way everywhere (spinner, ✓, ✗).",
      "type": "string",
      "enum": ["pending", "running", "done", "failed"]
    },
    "ViewOp": {
      "type": "object",
      "oneOf": [
        { "$ref": "#/$defs/SetViewOp" },
        { "$ref": "#/$defs/BlocksViewOp" },
        { "$ref": "#/$defs/RemoveViewOp" }
      ],
      "discriminator": { "propertyName": "op" }
    },
    "SetViewOp": {
      "description": "Replace the item with this ref, or append it if it's new.",
      "type": "object",
      "properties": {
        "op": { "const": "set" },
        "item": { "$ref": "#/$defs/ViewItem" }
      },
      "required": ["op", "item"],
      "additionalProperties": false
    },
    "BlocksViewOp": {
      "description": "Streaming text: in the text component at `path` (child indexes from the item's component; [] is the component itself), replace blocks[from..] with these.",
      "type": "object",
      "properties": {
        "op": { "const": "blocks" },
        "ref": { "type": "string" },
        "path": { "type": "array", "items": { "type": "integer" } },
        "from": { "type": "integer", "minimum": 0 },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/Block" } }
      },
      "required": ["op", "ref", "path", "from", "blocks"],
      "additionalProperties": false
    },
    "RemoveViewOp": {
      "type": "object",
      "properties": {
        "op": { "const": "remove" },
        "ref": { "type": "string" }
      },
      "required": ["op", "ref"],
      "additionalProperties": false
    },
    "ViewSnapshot": {
      "description": "Everything in the session as drawn, as of seq.",
      "type": "object",
      "properties": {
        "session": { "type": "string" },
        "seq": { "type": "integer" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/ViewItem" } }
      },
      "required": ["session", "seq", "items"],
      "additionalProperties": false
    },
    "ViewPatch": {
      "description": "Changes caused by the session event with this seq, applied in order.",
      "type": "object",
      "properties": {
        "session": { "type": "string" },
        "seq": { "type": "integer" },
        "ops": { "type": "array", "items": { "$ref": "#/$defs/ViewOp" } }
      },
      "required": ["session", "seq", "ops"],
      "additionalProperties": false
    },
    "Theme": {
      "description": "Theme tokens served by the daemon. Web maps them to CSS variables, GPUI to its theme, TUIs to the nearest 16/256/true color.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "colors": { "$ref": "#/$defs/ThemeColors" },
        "spacing": { "$ref": "#/$defs/ThemeSpacing" },
        "text": { "$ref": "#/$defs/ThemeText" }
      },
      "required": ["name", "colors", "spacing", "text"],
      "additionalProperties": false
    },
    "ThemeColors": {
      "description": "#rrggbb colors.",
      "type": "object",
      "properties": {
        "fg": { "type": "string" },
        "bg": { "type": "string" },
        "surface": { "type": "string", "description": "Card and code backgrounds." },
        "border": { "type": "string" },
        "accent": { "type": "string" },
        "muted": { "type": "string" },
        "success": { "type": "string" },
        "danger": { "type": "string" }
      },
      "required": ["fg", "bg", "surface", "border", "accent", "muted", "success", "danger"],
      "additionalProperties": false
    },
    "ThemeSpacing": {
      "description": "Pixels. TUIs use 0/0/1 blank lines for s/m/l (see renderers/README.md).",
      "type": "object",
      "properties": {
        "s": { "type": "integer" },
        "m": { "type": "integer" },
        "l": { "type": "integer" }
      },
      "required": ["s", "m", "l"],
      "additionalProperties": false
    },
    "ThemeText": {
      "type": "object",
      "properties": {
        "title": { "$ref": "#/$defs/TextStyle" },
        "body": { "$ref": "#/$defs/TextStyle" },
        "code": { "$ref": "#/$defs/TextStyle" }
      },
      "required": ["title", "body", "code"],
      "additionalProperties": false
    },
    "TextStyle": {
      "type": "object",
      "properties": {
        "size": { "type": "integer", "description": "Pixels." },
        "weight": { "type": "integer" },
        "mono": { "type": "boolean" }
      },
      "required": ["size", "weight", "mono"],
      "additionalProperties": false
    }
  }
}
