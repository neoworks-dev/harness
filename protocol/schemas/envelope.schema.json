{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "envelope.schema.json",
  "title": "Envelope",
  "description": "Every bus frame (one JSON text frame per WebSocket message). Tagged by topic; id correlates requests with replies.",
  "$defs": {
    "Envelope": {
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/BusHello"
        },
        {
          "$ref": "#/$defs/BusWelcome"
        },
        {
          "$ref": "#/$defs/BusAck"
        },
        {
          "$ref": "#/$defs/BusError"
        },
        {
          "$ref": "#/$defs/SessionCreate"
        },
        {
          "$ref": "#/$defs/SessionList"
        },
        {
          "$ref": "#/$defs/SessionListResult"
        },
        {
          "$ref": "#/$defs/SessionSubscribe"
        },
        {
          "$ref": "#/$defs/SessionUnsubscribe"
        },
        {
          "$ref": "#/$defs/SessionSubscribed"
        },
        {
          "$ref": "#/$defs/SessionCancel"
        },
        {
          "$ref": "#/$defs/SessionInfoMessage"
        },
        {
          "$ref": "#/$defs/SessionEvents"
        },
        {
          "$ref": "#/$defs/SessionInputMessage"
        },
        {
          "$ref": "#/$defs/AppPresenceMessage"
        },
        {
          "$ref": "#/$defs/ConnectorsList"
        },
        {
          "$ref": "#/$defs/ConnectorsListResult"
        },
        {
          "$ref": "#/$defs/AgentFocusMessage"
        },
        {
          "$ref": "#/$defs/AgentMoveMessage"
        },
        {
          "$ref": "#/$defs/ConnectorsChanged"
        }
      ],
      "discriminator": {
        "propertyName": "topic"
      }
    },
    "BusHello": {
      "description": "Client → daemon, first frame. A protocol the daemon doesn't speak gets bus.error unsupported_protocol.",
      "type": "object",
      "properties": {
        "topic": {
          "const": "bus.hello"
        },
        "payload": {
          "$ref": "#/$defs/Hello"
        }
      },
      "required": ["topic", "payload"],
      "additionalProperties": false
    },
    "Hello": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "integer",
          "description": "Protocol version; currently 1."
        },
        "client": {
          "type": "string",
          "description": "Client name, e.g. cli or overlay."
        }
      },
      "required": ["protocol", "client"],
      "additionalProperties": false
    },
    "BusWelcome": {
      "description": "Daemon → client, reply to bus.hello.",
      "type": "object",
      "properties": {
        "topic": {
          "const": "bus.welcome"
        },
        "payload": {
          "$ref": "#/$defs/Welcome"
        }
      },
      "required": ["topic", "payload"],
      "additionalProperties": false
    },
    "Welcome": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "integer"
        },
        "daemonVersion": {
          "type": "string"
        },
        "pid": {
          "type": "integer"
        },
        "startedAt": {
          "type": "integer",
          "description": "Unix time in milliseconds."
        }
      },
      "required": ["protocol", "daemonVersion", "pid", "startedAt"],
      "additionalProperties": false
    },
    "BusAck": {
      "description": "Daemon → client: the request with this id was accepted.",
      "type": "object",
      "properties": {
        "topic": {
          "const": "bus.ack"
        },
        "id": {
          "type": "string"
        }
      },
      "required": ["topic", "id"],
      "additionalProperties": false
    },
    "BusError": {
      "description": "Daemon → client: a request failed, or (without id) a frame could not be handled.",
      "type": "object",
      "properties": {
        "topic": {
          "const": "bus.error"
        },
        "id": {
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ErrorInfo"
        }
      },
      "required": ["topic", "payload"],
      "additionalProperties": false
    },
    "ErrorInfo": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    },
    "ErrorCode": {
      "type": "string",
      "enum": ["bad_request", "not_found", "unsupported_protocol", "internal"]
    },
    "SessionCreate": {
      "description": "Client → daemon. Replied to with session.info.",
      "type": "object",
      "properties": {
        "topic": {
          "const": "session.create"
        },
        "id": {
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/SessionCreateParams"
        }
      },
      "required": ["topic", "id", "payload"],
      "additionalProperties": false
    },
    "SessionCreateParams": {
      "type": "object",
      "properties": {
        "cwd": {
          "type": "string",
          "description": "Working directory; defaults to the daemon's home dir."
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "SessionList": {
      "description": "Client → daemon. Replied to with session.list_result.",
      "type": "object",
      "properties": {
        "topic": {
          "const": "session.list"
        },
        "id": {
          "type": "string"
        }
      },
      "required": ["topic", "id"],
      "additionalProperties": false
    },
    "SessionListResult": {
      "type": "object",
      "properties": {
        "topic": {
          "const": "session.list_result"
        },
        "id": {
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/SessionListPayload"
        }
      },
      "required": ["topic", "id", "payload"],
      "additionalProperties": false
    },
    "SessionListPayload": {
      "type": "object",
      "properties": {
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "session.schema.json#/$defs/SessionInfo"
          }
        }
      },
      "required": ["sessions"],
      "additionalProperties": false
    },
    "SessionSubscribe": {
      "description": "Client → daemon. The daemon replays session.events from fromSeq, sends session.subscribed, then streams live events with no gaps or duplicates.",
      "type": "object",
      "properties": {
        "topic": {
          "const": "session.subscribe"
        },
        "id": {
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/SubscribeParams"
        }
      },
      "required": ["topic", "id", "payload"],
      "additionalProperties": false
    },
    "SubscribeParams": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string"
        },
        "fromSeq": {
          "type": "integer",
          "minimum": 1,
          "description": "First seq to replay (inclusive). Defaults to 1."
        }
      },
      "required": ["session"],
      "additionalProperties": false
    },
    "SessionUnsubscribe": {
      "type": "object",
      "properties": {
        "topic": {
          "const": "session.unsubscribe"
        },
        "id": {
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/SessionRef"
        }
      },
      "required": ["topic", "id", "payload"],
      "additionalProperties": false
    },
    "SessionRef": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string"
        }
      },
      "required": ["session"],
      "additionalProperties": false
    },
    "SessionSubscribed": {
      "description": "Daemon → client, after the replay for subscription id. Everything after this is live.",
      "type": "object",
      "properties": {
        "topic": {
          "const": "session.subscribed"
        },
        "id": {
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/SubscribedPayload"
        }
      },
      "required": ["topic", "id", "payload"],
      "additionalProperties": false
    },
    "SubscribedPayload": {
      "type": "object",
      "properties": {
        "session": {
          "$ref": "session.schema.json#/$defs/SessionInfo"
        },
        "replayedThrough": {
          "type": "integer",
          "description": "Last seq in the log when the subscription started. Events up to it (from fromSeq) were replayed; everything after it arrives live."
        }
      },
      "required": ["session", "replayedThrough"],
      "additionalProperties": false
    },
    "SessionCancel": {
      "description": "Client → daemon: cancel the running turn (acked). The turn ends with turn_ended cancelled; queued inputs still run. When idle it is acked and nothing else happens.",
      "type": "object",
      "properties": {
        "topic": {
          "const": "session.cancel"
        },
        "id": {
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/SessionRef"
        }
      },
      "required": ["topic", "id", "payload"],
      "additionalProperties": false
    },
    "SessionInfoMessage": {
      "description": "Daemon → client: reply to session.create.",
      "type": "object",
      "properties": {
        "topic": {
          "const": "session.info"
        },
        "id": {
          "type": "string"
        },
        "payload": {
          "$ref": "session.schema.json#/$defs/SessionInfo"
        }
      },
      "required": ["topic", "id", "payload"],
      "additionalProperties": false
    },
    "SessionEvents": {
      "description": "Daemon → client: one session event (replayed or live).",
      "type": "object",
      "properties": {
        "topic": {
          "const": "session.events"
        },
        "payload": {
          "$ref": "session.schema.json#/$defs/SessionEventRecord"
        }
      },
      "required": ["topic", "payload"],
      "additionalProperties": false
    },
    "SessionInputMessage": {
      "description": "Client → daemon: submit input. With an id it is acked once queued; from then on session.list shows the session running or queued > 0. The user_message event is logged when the turn starts, not when it is queued.",
      "type": "object",
      "properties": {
        "topic": {
          "const": "session.input"
        },
        "id": {
          "type": "string"
        },
        "payload": {
          "$ref": "session.schema.json#/$defs/SessionInput"
        }
      },
      "required": ["topic", "payload"],
      "additionalProperties": false
    },
    "AppPresenceMessage": {
      "description": "Client → daemon: connector registration. Acked when it has an id; invalid registrations get bus.error.",
      "type": "object",
      "properties": {
        "topic": {
          "const": "app.presence"
        },
        "payload": {
          "$ref": "presence.schema.json#/$defs/AppPresence"
        },
        "id": {
          "type": "string"
        }
      },
      "required": ["topic", "payload"],
      "additionalProperties": false
    },
    "ConnectorsList": {
      "description": "Client → daemon. Replied to with connectors.list_result.",
      "type": "object",
      "properties": {
        "topic": {
          "const": "connectors.list"
        },
        "id": {
          "type": "string"
        }
      },
      "required": ["topic", "id"],
      "additionalProperties": false
    },
    "ConnectorsListResult": {
      "type": "object",
      "properties": {
        "topic": {
          "const": "connectors.list_result"
        },
        "id": {
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ConnectorsListPayload"
        }
      },
      "required": ["topic", "id", "payload"],
      "additionalProperties": false
    },
    "ConnectorsListPayload": {
      "type": "object",
      "properties": {
        "connectors": {
          "type": "array",
          "items": {
            "$ref": "presence.schema.json#/$defs/ConnectorInfo"
          }
        }
      },
      "required": ["connectors"],
      "additionalProperties": false
    },
    "AgentFocusMessage": {
      "description": "Daemon → every client after bus.welcome and on every change: where the agent lives. The app named here opens its chat pane on the session (replay, then live); others collapse theirs.",
      "type": "object",
      "properties": {
        "topic": {
          "const": "agent.focus"
        },
        "payload": {
          "$ref": "#/$defs/AgentFocus"
        }
      },
      "required": ["topic", "payload"],
      "additionalProperties": false
    },
    "AgentFocus": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "description": "The current session: the one the agent is working in."
        },
        "app": {
          "type": "string",
          "description": "App whose pane has the agent. Absent when no app can host it (nothing open)."
        },
        "from": {
          "type": "string",
          "description": "Where it was before, if it was in an app."
        },
        "reason": {
          "$ref": "#/$defs/FocusReason"
        }
      },
      "required": ["session", "reason"],
      "additionalProperties": false
    },
    "FocusReason": {
      "description": "initial: sent after bus.welcome; user: an app or the CLI moved it; agent: the agent called apps_focus; closed: its app went away; opened: an app opened while the agent had none; session: the current session changed.",
      "type": "string",
      "enum": ["initial", "user", "agent", "closed", "opened", "session"]
    },
    "AgentMoveMessage": {
      "description": "Client → daemon: move the agent (acked). app must be an open connector of kind app; without app it goes home. With session, that session becomes the current one.",
      "type": "object",
      "properties": {
        "topic": {
          "const": "agent.move"
        },
        "id": {
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/AgentMove"
        }
      },
      "required": ["topic", "id", "payload"],
      "additionalProperties": false
    },
    "AgentMove": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string"
        },
        "session": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ConnectorsChanged": {
      "description": "Daemon → every client when a connector opens, closes or changes.",
      "type": "object",
      "properties": {
        "topic": {
          "const": "connectors.changed"
        },
        "payload": {
          "$ref": "#/$defs/ConnectorsListPayload"
        }
      },
      "required": ["topic", "payload"],
      "additionalProperties": false
    }
  }
}
