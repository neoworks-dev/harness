{
  "name": "neo",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "protocol",
    "daemon",
    "neo",
    "sdk-ts",
    "renderers/web",
    "services/lsp",
    "apps/gui",
    "apps/shell-widget"
  ],
  "scripts": {
    "codegen": "bun run --cwd protocol codegen",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "daemon": "bun run daemon/src/main.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
